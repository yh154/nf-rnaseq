// Copy, edit and pass with:  nextflow run . -profile slurm,apptainer -c site.config ...
// Set the largest resources a single job may request on YOUR cluster.
process {
    resourceLimits = [ cpus: 32, memory: 250.GB, time: 48.h ]
    // clusterOptions = '--account=<account> --qos=<qos>'
}
executor {
    queueSize = 50
}
// Do NOT add an `apptainer { }` block here: some Nextflow versions (seen on 24.10.3) reject it
// ("Unknown config attribute `apptainer`"). Set the image cache with an environment variable:
//   export NXF_APPTAINER_CACHEDIR=/path/to/shared/apptainer_cache
// module/env setup if Apptainer is a module on your cluster:
// process.beforeScript = 'module load apptainer'
