// Synthetic test dataset (generate first: python3 tests/make_synthetic.py).
params {
    input     = "${projectDir}/tests/data/samples_pe.csv"
    contrast  = "${projectDir}/tests/data/contrasts.csv"
    gfasta    = "${projectDir}/tests/data/genome.fa"
    gtf       = "${projectDir}/tests/data/genes.gtf"
    gmt       = "${projectDir}/tests/data/test.gmt"
    outdir    = 'results_test'
    design    = '~ batch + condition'
    min_set_size = 5      // the synthetic gene sets have 6-8 genes
}
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
    // The tiny genome needs far less than the human defaults; keeps 2 tasks inside a
    // 7-8 GB Docker VM.
    withLabel: process_high {
        cpus   = 2
        memory = { 3.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
executor {
    cpus   = 4
    memory = '7 GB'
}
