// Slurm HPC (primary target). Combine with a container profile:
//   -profile slurm,apptainer --queue <partition> -c site.config
// The caps below are placeholders: copy conf/site.example.config, set your cluster's
// real maxima and pass it with -c.
process {
    executor = 'slurm'
    resourceLimits = [ cpus: 32, memory: 256.GB, time: 72.h ]
    queue = params.queue
}
executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
}
