// nf-rnaseq: bulk RNA-seq (STAR + RSEM + DESeq2). See README / `nextflow run . --help`.

manifest {
    name            = 'nf-rnaseq'
    description     = 'Bulk RNA-seq: STAR+RSEM, DESeq2, optional GSEA/GSVA'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
}

params {
    // input / output
    input               = null
    contrast            = null
    fastq_dir           = null
    outdir              = null
    // reference
    gfasta              = null
    gtf                 = null
    rsem_ref            = null
    star_sjdboverhang   = 'auto'
    // DESeq2
    design              = '~ condition'
    padj                = 0.05
    lfc                 = 1
    min_count           = 10
    // GSEA / GSVA / plots
    gmt                 = null
    gmt_id_type         = 'gene_name'
    min_set_size        = 5
    max_set_size        = 500
    gsva_top            = 10
    gsva_input          = 'vst'
    pca_ntop            = 500
    run_date            = new Date().format('ddMMyy')
    // misc
    no_bam              = false
    queue               = null
    help                = false
    version             = false
}

includeConfig 'conf/base.config'

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    docker {
        includeConfig 'conf/containers.config'
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    apptainer {
        includeConfig 'conf/containers.config'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// tracing is off for --help / --version / when --outdir is missing
trace {
    enabled   = params.outdir != null && !params.help && !params.version
    file      = "${params.outdir ?: '.'}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,cpus,memory,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

cleanup = false
